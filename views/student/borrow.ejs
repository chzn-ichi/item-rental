<%- include('../partials/student-top', { title: 'Borrow', activePage: 'borrow' }) %>

<%
  const blocked = penalty.count > 0;
  const atLimit = inProgress >= maxRentals;
%>

<div class="page-head">
    <div>
        <h1 class="page-title">Borrow an item</h1>
        <p class="page-sub">Pick something available and send a request.</p>
    </div>
    <span class="chip"><i class="ti ti-package" aria-hidden="true"></i><%= inProgress %> of <%= maxRentals %> rentals in use</span>
</div>

<%- include('../partials/messages', { success: success, error: error }) %>

<% if (blocked) { %>
    <div class="alert alert-error" role="alert">
        <i class="ti ti-coin" aria-hidden="true"></i>
        <span>You have an unpaid penalty of <%= helpers.formatMoney(penalty.total) %>. Settle it with the dorm officer to borrow again.</span>
    </div>
<% } else if (atLimit) { %>
    <div class="alert alert-warning" role="alert">
        <i class="ti ti-alert-triangle" aria-hidden="true"></i>
        <span>You already have <%= inProgress %> rental(s) in progress. The maximum is <%= maxRentals %>.</span>
    </div>
<% } %>

<div class="category-filter">
    <a href="/borrow" class="filter-btn <%= category === 'all' ? 'active' : '' %>">All categories</a>
    <% categories.forEach(cat => { %>
        <a href="/borrow?category=<%= encodeURIComponent(cat) %>" class="filter-btn <%= category === cat ? 'active' : '' %>"><%= cat %></a>
    <% }) %>
</div>

<div class="table-container">
    <h3>Available items (<%= items.length %>)</h3>
    <% if (items.length > 0) { %>
        <table class="data-table">
            <thead>
                <tr><th>Item code</th><th>Item name</th><th>Category</th><th>Action</th></tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                    <tr>
                        <td><strong><%= item.itemCode %></strong></td>
                        <td><%= item.itemName %></td>
                        <td><%- helpers.categoryBadge(item.category) %></td>
                        <td>
                            <% if (blocked) { %>
                                <button class="btn-disabled btn-sm" disabled>Unpaid penalty</button>
                            <% } else if (atLimit) { %>
                                <button class="btn-disabled btn-sm" disabled>Limit reached</button>
                            <% } else { %>
                                <form method="POST" action="/borrow?category=<%= encodeURIComponent(category) %>"
                                      data-confirm="Request to borrow <%= item.itemName %> (<%= item.itemCode %>)? It counts toward your limit of <%= maxRentals %> rentals until it's returned, and the admin must approve it first."
                                      data-confirm-title="Borrow this item" data-confirm-label="Request to borrow">
                                    <input type="hidden" name="item_id" value="<%= item._id %>">
                                    <button type="submit" class="btn-primary btn-sm">Borrow</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><i class="ti ti-package-off" aria-hidden="true"></i><p>No available items in this category.</p></div>
    <% } %>
</div>

<%- include('../partials/student-bottom') %>