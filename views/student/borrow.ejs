<%- include('../partials/student-top', { title: 'Borrow', activePage: 'borrow' }) %>

<%
  const blocked = penalty.count > 0;
  const atLimit = inProgress >= maxRentals;
%>

<div class="page-head">
    <div>
        <h1 class="page-title">Borrow an item</h1>
        <p class="page-sub">Pick something available and send a request.</p>
    </div>
    <span class="chip"><%= inProgress %> of <%= maxRentals %> rentals in use</span>
</div>

<%- include('../partials/messages', { success: success, error: error }) %>

<% if (blocked) { %>
    <div class="alert alert-error" role="alert">
        You have an unpaid penalty of <%= helpers.formatMoney(penalty.total) %>. Settle it with the dorm officer to borrow again.
    </div>
<% } else if (atLimit) { %>
    <div class="alert alert-warning" role="alert">
        You already have <%= inProgress %> rental(s) in progress. The maximum is <%= maxRentals %>.
    </div>
<% } %>

<div class="search-box">
    <i class="ti ti-search" aria-hidden="true"></i>
    <input type="text" data-search placeholder="Search by name or code" aria-label="Search items" autocomplete="off">
</div>

<div class="category-filter">
    <a href="/borrow" class="filter-btn <%= category === 'all' ? 'active' : '' %>">All categories</a>
    <% categories.forEach(cat => { %>
        <a href="/borrow?category=<%= encodeURIComponent(cat) %>" class="filter-btn <%= category === cat ? 'active' : '' %>"><%= cat %></a>
    <% }) %>
</div>

<h2 class="section-label">Available items (<span id="result-count"><%= items.length %></span>)</h2>

<% if (items.length > 0) { %>
    <div class="item-grid">
        <% items.forEach(item => { %>
            <article class="item-card" data-search-item="<%= (item.itemName + ' ' + item.itemCode + ' ' + item.category).toLowerCase() %>">
                <div class="item-thumb"><%= item.itemCode %></div>
                <div>
                    <div class="item-name"><%= item.itemName %></div>
                </div>
                <div class="item-meta">
                    <%- helpers.categoryBadge(item.category) %>
                    <%- helpers.itemStatusBadge(item.status) %>
                </div>
                <% if (blocked) { %>
                    <button class="btn btn-disabled btn-sm" disabled>Unpaid penalty</button>
                <% } else if (atLimit) { %>
                    <button class="btn btn-disabled btn-sm" disabled>Limit reached</button>
                <% } else { %>
                    <form method="POST" action="/borrow?category=<%= encodeURIComponent(category) %>"
                          data-confirm="Request to borrow <%= item.itemName %> (<%= item.itemCode %>)? It counts toward your limit of <%= maxRentals %> rentals until it's returned, and the admin must approve it first."
                          data-confirm-title="Borrow this item" data-confirm-label="Request to borrow">
                        <input type="hidden" name="item_id" value="<%= item._id %>">
                        <button type="submit" class="btn btn-primary btn-sm">Borrow</button>
                    </form>
                <% } %>
            </article>
        <% }) %>
    </div>
    <div class="table-container" id="search-empty" hidden>
        <div class="empty-state"><p>No items match your search.</p></div>
    </div>
<% } else { %>
    <div class="table-container">
        <div class="empty-state"><p>No available items in this category.</p></div>
    </div>
<% } %>

<%- include('../partials/student-bottom') %>