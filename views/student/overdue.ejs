<%- include('../partials/student-top', { title: 'Overdue Rentals', activePage: 'overdue' }) %>

<h1 class="page-title">Overdue Rentals</h1>

<div class="table-container">
    <% if (rentals.length > 0) { %>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Item Code</th><th>Item Name</th><th>Category</th>
                    <th>Borrow Date</th><th>Due Date</th><th>Days Overdue</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% rentals.forEach(r => { %>
                    <tr>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%= helpers.formatDate(r.dueDate) %></td>
                        <td><span style="color: #EF4444; font-weight: bold;"><%= helpers.daysOverdue(r.dueDate) %> days</span></td>
                        <td><%- helpers.rentalStatusBadge(r.status) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state">No overdue rentals. Great job returning on time!</div>
    <% } %>
</div>

<%- include('../partials/student-bottom') %>