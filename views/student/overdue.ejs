<%- include('../partials/student-top', { title: 'Overdue', activePage: 'overdue' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Overdue rentals</h1>
        <p class="page-sub">Return these as soon as you can.</p>
    </div>
</div>

<div class="table-container">
    <% if (rentals.length > 0) { %>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Item code</th><th>Item name</th><th>Category</th>
                    <th>Borrow date</th><th>Due date</th><th>Days overdue</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% rentals.forEach(r => { %>
                    <tr>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%= helpers.formatDate(r.dueDate) %></td>
                        <td><span class="text-danger"><%= helpers.daysOverdue(r.dueDate) %> days</span></td>
                        <td><%- helpers.rentalStatusBadge(r.status) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><i class="ti ti-mood-smile" aria-hidden="true"></i><p>No overdue rentals. Great job returning on time!</p></div>
    <% } %>
</div>

<%- include('../partials/student-bottom') %>