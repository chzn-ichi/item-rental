<%- include('../partials/student-top', { title: 'Dashboard', activePage: 'dashboard' }) %>

<section class="hero">
    <div>
        <h1>Hello, <%= currentUser.name.split(' ')[0] %></h1>
        <p>Borrow what you need, return when you're done.</p>
    </div>
    <a href="/borrow" class="btn btn-light"><i class="ti ti-package" aria-hidden="true"></i>Borrow an item</a>
</section>

<% if (penalty.count > 0) { %>
    <div class="alert alert-error" role="alert">
        <i class="ti ti-coin" aria-hidden="true"></i>
        <span>You have an unpaid penalty of <strong><%= helpers.formatMoney(penalty.total) %></strong>. You can't borrow new items until it's settled with the dorm officer. <a href="/penalties">View details</a></span>
    </div>
<% } %>

<div class="stats-grid">
    <a href="/borrow" class="stat-card card-borrow">
        <span class="stat-icon"><i class="ti ti-package" aria-hidden="true"></i></span>
        <div class="stat-value"><%= availableItems %></div>
        <div class="stat-label">Items available</div>
    </a>
    <a href="/my-rentals?tab=active" class="stat-card card-active">
        <span class="stat-icon"><i class="ti ti-refresh" aria-hidden="true"></i></span>
        <div class="stat-value"><%= activeRentals %></div>
        <div class="stat-label">Active rentals</div>
    </a>
    <a href="/my-rentals?tab=pending" class="stat-card card-pending">
        <span class="stat-icon"><i class="ti ti-hourglass-high" aria-hidden="true"></i></span>
        <div class="stat-value"><%= pendingRequests %></div>
        <div class="stat-label">Pending requests</div>
    </a>
    <a href="/overdue" class="stat-card card-overdue">
        <span class="stat-icon"><i class="ti ti-alert-triangle" aria-hidden="true"></i></span>
        <div class="stat-value"><%= overdueRentals %></div>
        <div class="stat-label">Overdue rentals</div>
    </a>
</div>

<div class="section-card">
    <div class="section-header">
        <h2>Recent rentals</h2>
        <a href="/my-rentals">View all</a>
    </div>
    <% if (recentRentals.length > 0) { %>
        <table class="mini-table">
            <thead>
                <tr><th>Item</th><th>Category</th><th>Borrow date</th><th>Status</th></tr>
            </thead>
            <tbody>
                <% recentRentals.forEach(r => { %>
                    <tr class="clickable-row" data-href="/my-rentals">
                        <td><%= r.itemName %> <small>(<%= r.itemCode %>)</small></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%- helpers.rentalStatusBadge(r.status) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><i class="ti ti-mood-smile" aria-hidden="true"></i><p>No rentals yet. Start borrowing!</p></div>
    <% } %>
</div>

<p class="dashboard-footer">Dormitory Item Rental System | Borrow responsibly, return on time</p>

<%- include('../partials/student-bottom') %>