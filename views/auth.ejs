<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Item Rental System - Login & Register</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-container">
        <!-- Left Panel - Branding Section -->
        <div class="auth-left">
            <div class="brand-content">
                <div class="brand-icon">
                    <span class="brand-logo">R</span>
                </div>
                <h1 class="brand-title">Dorm Item Rental</h1>
                <p class="brand-description">Efficient dormitory item management for students and staff.</p>

                <div class="feature-list">
                    <div class="feature-item"><div class="feature-check">✓</div><span>Easy item borrowing</span></div>
                    <div class="feature-item"><div class="feature-check">✓</div><span>Track your rentals</span></div>
                    <div class="feature-item"><div class="feature-check">✓</div><span>Multiple categories</span></div>
                    <div class="feature-item"><div class="feature-check">✓</div><span>Penalty management</span></div>
                </div>
            </div>
        </div>

        <!-- Right Panel - Form Section -->
        <div class="auth-right">
            <div class="form-container">
                <div class="form-toggles">
                    <button type="button" class="toggle-btn <%= activeForm === 'login' ? 'active' : '' %>" onclick="showForm('login', this)">Login</button>
                    <button type="button" class="toggle-btn <%= activeForm === 'register' ? 'active' : '' %>" onclick="showForm('register', this)">Register</button>
                </div>

                <!-- Login Form -->
                <div id="login-form" class="auth-form" style="display: <%= activeForm === 'login' ? 'block' : 'none' %>">
                    <h2>Welcome Back</h2>
                    <p class="form-subtitle">Login to manage your item rentals</p>

                    <% if (error && activeForm === 'login') { %>
                        <div class="alert alert-error"><%= error %></div>
                    <% } %>
                    <% if (success && activeForm === 'login') { %>
                        <div class="alert alert-success"><%= success %></div>
                    <% } %>

                    <form method="POST" action="/login">
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" required placeholder="your@email.com">
                        </div>
                        <div class="form-group">
                            <label>Password</label>
                            <input type="password" name="password" required placeholder="••••••••">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Login</button>
                    </form>
                </div>

                <!-- Register Form -->
                <div id="register-form" class="auth-form" style="display: <%= activeForm === 'register' ? 'block' : 'none' %>">
                    <h2>Create Account</h2>
                    <p class="form-subtitle">Join us to start borrowing items</p>

                    <% if (error && activeForm === 'register') { %>
                        <div class="alert alert-error"><%= error %></div>
                    <% } %>

                    <form method="POST" action="/register">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="name" required placeholder="Juan Dela Cruz">
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" required placeholder="juan@student.com">
                        </div>
                        <div class="form-group">
                            <label>Password</label>
                            <input type="password" name="password" required placeholder="Minimum 6 characters">
                        </div>
                        <div class="form-group">
                            <label>Confirm Password</label>
                            <input type="password" name="confirm_password" required placeholder="Re-enter password">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Register Now</button>
                    </form>

                    <p class="form-footer">Already have an account? <a href="#" onclick="showForm('login'); return false;">Login here</a></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function showForm(form, btn) {
            document.getElementById('login-form').style.display = form === 'login' ? 'block' : 'none';
            document.getElementById('register-form').style.display = form === 'register' ? 'block' : 'none';
            document.querySelectorAll('.toggle-btn').forEach((b, i) => {
                b.classList.toggle('active', (i === 0) === (form === 'login'));
            });
        }
    </script>
</body>
</html>