<%- include('partials/auth-top', { title: 'Reset password' }) %>

<div class="auth-form">
    <h2>Set a new password</h2>
    <p class="form-subtitle">Choose a new password for your account</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/reset-password/<%= token %>">
        <%- include('partials/password-field', { label: 'New password', name: 'password', placeholder: 'Minimum 6 characters' }) %>
        <%- include('partials/password-field', { label: 'Confirm new password', name: 'confirm_password', placeholder: 'Re-enter password' }) %>
        <button type="submit" class="btn btn-primary btn-block">Reset password</button>
    </form>

    <p class="form-footer"><a href="/login">&larr; Back to login</a></p>
</div>

<%- include('partials/auth-bottom') %>