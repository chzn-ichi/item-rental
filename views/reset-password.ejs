<%- include('partials/auth-top', { title: 'Reset password' }) %>

<div class="auth-form">
    <h2>Reset your password</h2>
    <p class="form-subtitle">Enter the 6-digit code we emailed to <strong><%= email %></strong> and choose a new password.</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <form method="POST" action="/reset-password">
        <div class="form-group">
            <label>Reset code</label>
            <input type="text" name="code" class="code-input" inputmode="numeric"
                   autocomplete="one-time-code" maxlength="6" pattern="\d{6}"
                   placeholder="000000" required autofocus>
        </div>
        <%- include('partials/password-field', { label: 'New password', name: 'password', placeholder: 'Minimum 6 characters' }) %>
        <%- include('partials/password-field', { label: 'Confirm new password', name: 'confirm_password', placeholder: 'Re-enter password' }) %>
        <button type="submit" class="btn btn-primary btn-block">Reset password</button>
    </form>

    <form method="POST" action="/reset-password/resend" class="form-footer">
        Didn't get it? <button type="submit" class="link-btn">Send a new code</button>
    </form>

    <p class="form-footer"><a href="/login">&larr; Back to login</a></p>
</div>

<%- include('partials/auth-bottom') %>