<% if (locals.success) { %>
    <div class="toast" role="status">
        <i class="ti ti-circle-check" aria-hidden="true"></i><span><%= success %></span>
    </div>
<% } %>
<% if (locals.error) { %>
    <div class="alert alert-error" role="alert">
        <i class="ti ti-alert-circle" aria-hidden="true"></i><span><%= error %></span>
    </div>
<% } %>