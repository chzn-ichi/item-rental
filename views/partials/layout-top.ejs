<%
  const isAdminUser = currentUser && currentUser.role === 'admin';
  const home = isAdminUser ? '/admin/dashboard' : '/dashboard';
  const links = isAdminUser
    ? [
        ['dashboard', '/admin/dashboard', 'Dashboard', 'ti-layout-dashboard'],
        ['items', '/admin/items', 'Items', 'ti-box'],
        ['rentals', '/admin/rentals', 'Rentals', 'ti-clipboard-list'],
        ['returns', '/admin/returns', 'Returns', 'ti-arrow-back-up'],
        ['penalties', '/admin/penalties', 'Penalties', 'ti-coin'],
        ['history', '/admin/history', 'History', 'ti-history'],
      ]
    : [
        ['dashboard', '/dashboard', 'Dashboard', 'ti-layout-dashboard'],
        ['borrow', '/borrow', 'Borrow', 'ti-package'],
        ['myrentals', '/my-rentals', 'My rentals', 'ti-list-details'],
        ['overdue', '/overdue', 'Overdue', 'ti-alert-triangle'],
        ['penalties', '/penalties', 'Penalties', 'ti-coin'],
      ];
  const flashMsg = locals.flash || {};
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - UniRent</title>
    <script>try { if (localStorage.getItem('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light'); } catch (e) {}</script>
    <link rel="icon" type="image/svg+xml" href="/img/icon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<aside class="rail">
    <a class="rail-brand" href="<%= home %>" aria-label="UniRent home">
        <img class="logo-on-dark" src="/img/logo-mark-light.svg" alt="">
        <img class="logo-on-light" src="/img/logo-mark.svg" alt="">
        <span class="brand-text">ni<span>Rent</span></span>
    </a>

    <nav class="rail-links" aria-label="Main">
        <% links.forEach(([key, href, label, icon]) => { %>
            <a href="<%= href %>" class="rail-link <%= activePage === key ? 'active' : '' %>" title="<%= label %>" aria-label="<%= label %>">
                <i class="ti <%= icon %>" aria-hidden="true"></i><span><%= label %></span>
            </a>
        <% }) %>
    </nav>

    <div class="rail-foot">
        <% if (!isAdminUser) { %>
            <a href="/profile" class="rail-link <%= activePage === 'profile' ? 'active' : '' %>" title="My profile" aria-label="My profile">
                <i class="ti ti-user-circle" aria-hidden="true"></i><span><%= currentUser.name %></span>
            </a>
        <% } %>
        <button type="button" class="rail-link" data-theme-toggle title="Switch theme" aria-label="Switch theme">
            <i class="ti ti-moon icon-moon" aria-hidden="true"></i><i class="ti ti-sun icon-sun" aria-hidden="true"></i><span>Switch theme</span>
        </button>
        <a href="/logout" class="rail-link logout" title="Logout" aria-label="Logout">
            <i class="ti ti-logout" aria-hidden="true"></i><span>Logout</span>
        </a>
    </div>
</aside>

<main class="page">
    <% if (locals.showTitle) { %>
        <h1 class="page-title"><%= title %></h1>
    <% } %>
    <%- include('messages', { success: flashMsg.success, error: flashMsg.error }) %>