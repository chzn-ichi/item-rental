<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Item Rental System</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-container">
        <!-- Left Panel - Branding Section -->
        <div class="auth-left">
            <div class="brand-content">
                <div class="brand-icon">
                    <span class="brand-logo">R</span>
                </div>
                <h1 class="brand-title">Dorm Item Rental</h1>
                <p class="brand-description">Efficient dormitory item management for students and staff.</p>

                <div class="feature-list">
                    <div class="feature-item"><div class="feature-check">&#10003;</div><span>Easy item borrowing</span></div>
                    <div class="feature-item"><div class="feature-check">&#10003;</div><span>Track your rentals</span></div>
                    <div class="feature-item"><div class="feature-check">&#10003;</div><span>Multiple categories</span></div>
                    <div class="feature-item"><div class="feature-check">&#10003;</div><span>Penalty management</span></div>
                </div>
            </div>
        </div>

        <!-- Right Panel - Form Section -->
        <div class="auth-right">
            <div class="form-container">
                <div class="auth-form" style="display: block">
                    <h2>Forgot Password?</h2>
                    <p class="form-subtitle">Enter your email and we'll send you a link to reset your password</p>

                    <% if (error) { %>
                        <div class="alert alert-error"><%= error %></div>
                    <% } %>
                    <% if (success) { %>
                        <div class="alert alert-success"><%= success %></div>
                    <% } %>

                    <form method="POST" action="/forgot-password">
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" name="email" required placeholder="your@email.com">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Send Reset Link</button>
                    </form>

                    <p class="form-footer"><a href="/login">&larr; Back to Login</a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>