<%- include('../partials/admin-top', { title: 'Manage Items', activePage: 'items' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Manage items</h1>
        <p class="page-sub">Add, edit, and track the condition of every item.</p>
    </div>
</div>

<div class="table-container">
    <h3>Add new item</h3>
    <form method="POST" action="/admin/items/add" class="card-body">
        <input type="hidden" name="back_category" value="<%= category %>">
        <div class="form-row">
            <div>
                <label>Item code</label>
                <input type="text" name="item_code" required placeholder="CAT-001" class="field">
            </div>
            <div>
                <label>Item name</label>
                <input type="text" name="item_name" required placeholder="Item name" class="field">
            </div>
            <div>
                <label>Category</label>
                <select name="category" class="field">
                    <% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
                </select>
            </div>
            <div>
                <label>Initial status</label>
                <select name="status" class="field">
                    <option value="available">Available</option>
                    <option value="maintenance">Under maintenance</option>
                    <option value="damaged">Damaged</option>
                </select>
            </div>
            <div><button type="submit" class="btn btn-primary btn-block">Add item</button></div>
        </div>
    </form>
</div>

<div class="category-filter">
    <a href="/admin/items" class="filter-btn <%= category === 'all' ? 'active' : '' %>">All categories</a>
    <% categories.forEach(c => { %>
        <a href="/admin/items?category=<%= encodeURIComponent(c) %>" class="filter-btn <%= category === c ? 'active' : '' %>"><%= c %></a>
    <% }) %>
</div>

<div class="table-container">
    <h3>All items<% if (category !== 'all') { %> - <%= category %><% } %> <span class="count">(<%= items.length %>)</span></h3>
    <% if (items.length > 0) { %>
        <table>
            <thead>
                <tr><th>Item code</th><th>Item name</th><th>Category</th><th>Status</th><th>Date added</th><th>Actions</th></tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                    <tr>
                        <td>
                            <!-- Empty form; the inputs in this row point to it with the form="" attribute -->
                            <form id="edit-<%= item._id %>" method="POST" action="/admin/items/<%= item._id %>/edit">
                                <input type="hidden" name="back_category" value="<%= category %>">
                            </form>
                            <input form="edit-<%= item._id %>" type="text" name="item_code" value="<%= item.itemCode %>" class="edit-input" required>
                        </td>
                        <td><input form="edit-<%= item._id %>" type="text" name="item_name" value="<%= item.itemName %>" class="edit-input wide" required></td>
                        <td>
                            <select form="edit-<%= item._id %>" name="category" class="select-sm">
                                <% categories.forEach(c => { %>
                                    <option value="<%= c %>" <%= item.category === c ? 'selected' : '' %>><%= c %></option>
                                <% }) %>
                            </select>
                        </td>
                        <td>
                            <% if (item.status === 'rented') { %>
                                <%- helpers.itemStatusBadge('rented') %>
                            <% } else { %>
                                <form method="POST" action="/admin/items/<%= item._id %>/status">
                                    <input type="hidden" name="back_category" value="<%= category %>">
                                    <select name="status" onchange="this.form.submit()" class="select-sm">
                                        <option value="available" <%= item.status === 'available' ? 'selected' : '' %>>Available</option>
                                        <option value="maintenance" <%= item.status === 'maintenance' ? 'selected' : '' %>>Under maintenance</option>
                                        <option value="damaged" <%= item.status === 'damaged' ? 'selected' : '' %>>Damaged</option>
                                    </select>
                                </form>
                            <% } %>
                        </td>
                        <td><%= helpers.formatDate(item.createdAt) %></td>
                        <td>
                            <div class="row-actions">
                                <button form="edit-<%= item._id %>" type="submit" class="btn btn-sm btn-primary">Save</button>
                                <form method="POST" action="/admin/items/<%= item._id %>/delete"
                                      data-confirm="This item will be permanently deleted."
                                      data-confirm-title="Delete item" data-confirm-label="Delete" data-confirm-type="danger">
                                    <input type="hidden" name="back_category" value="<%= category %>">
                                    <button type="submit" class="btn btn-sm btn-danger-outline">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><p>No items found. Add your first item above.</p></div>
    <% } %>
</div>

<%- include('../partials/admin-bottom') %>