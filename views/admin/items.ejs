<%- include('../partials/admin-top', { title: 'Manage Items', activePage: 'items' }) %>

<style>
    .category-filter { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; padding: 12px; background: #F9FAFB; border-radius: 12px; }
    .filter-link { padding: 6px 16px; border-radius: 20px; text-decoration: none; font-size: 13px; background: #E5E7EB; color: #374151; }
    .filter-link.active { background: #1E3A5F; color: white; }
    .edit-input { padding: 4px 8px; font-size: 12px; border: 1px solid #D1D5DB; border-radius: 4px; width: 110px; }
    .field { width: 100%; padding: 8px; border: 1px solid #D1D5DB; border-radius: 6px; }
</style>

<!-- Add New Item -->
<div class="table-container" style="margin-bottom: 30px;">
    <h3 style="padding: 16px; margin: 0; border-bottom: 1px solid #E5E7EB;">Add New Item</h3>
    <form method="POST" action="/admin/items/add" style="padding: 16px;">
        <input type="hidden" name="back_category" value="<%= category %>">
        <div style="display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 120px;">
                <label style="display: block; margin-bottom: 5px;">Item Code</label>
                <input type="text" name="item_code" required placeholder="CAT-001" class="field">
            </div>
            <div style="flex: 1; min-width: 120px;">
                <label style="display: block; margin-bottom: 5px;">Item Name</label>
                <input type="text" name="item_name" required placeholder="Item name" class="field">
            </div>
            <div style="flex: 1; min-width: 150px;">
                <label style="display: block; margin-bottom: 5px;">Category</label>
                <select name="category" class="field">
                    <% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
                </select>
            </div>
            <div style="flex: 1; min-width: 120px;">
                <label style="display: block; margin-bottom: 5px;">Initial Status</label>
                <select name="status" class="field">
                    <option value="available">Available</option>
                    <option value="maintenance">Under Maintenance</option>
                    <option value="damaged">Damaged</option>
                </select>
            </div>
            <div><button type="submit" class="btn btn-primary">Add Item</button></div>
        </div>
    </form>
</div>

<!-- Category Filter -->
<div class="category-filter">
    <a href="/admin/items" class="filter-link <%= category === 'all' ? 'active' : '' %>">All Categories</a>
    <% categories.forEach(c => { %>
        <a href="/admin/items?category=<%= encodeURIComponent(c) %>" class="filter-link <%= category === c ? 'active' : '' %>"><%= c %></a>
    <% }) %>
</div>

<!-- Items List -->
<div class="table-container">
    <h3 style="padding: 16px; margin: 0; border-bottom: 1px solid #E5E7EB;">
        All Items<% if (category !== 'all') { %> - <%= category %><% } %> (<%= items.length %>)
    </h3>
    <% if (items.length > 0) { %>
        <div style="overflow-x: auto;">
            <table style="width: 100%;">
                <thead>
                    <tr><th>Item Code</th><th>Item Name</th><th>Category</th><th>Status</th><th>Date Added</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    <% items.forEach(item => { %>
                        <tr>
                            <td>
                                <!-- Empty form; the inputs in this row point to it with the form="" attribute -->
                                <form id="edit-<%= item._id %>" method="POST" action="/admin/items/<%= item._id %>/edit">
                                    <input type="hidden" name="back_category" value="<%= category %>">
                                </form>
                                <input form="edit-<%= item._id %>" type="text" name="item_code" value="<%= item.itemCode %>" class="edit-input" required>
                            </td>
                            <td><input form="edit-<%= item._id %>" type="text" name="item_name" value="<%= item.itemName %>" class="edit-input" required></td>
                            <td>
                                <select form="edit-<%= item._id %>" name="category" style="padding: 4px 8px; border-radius: 4px;">
                                    <% categories.forEach(c => { %>
                                        <option value="<%= c %>" <%= item.category === c ? 'selected' : '' %>><%= c %></option>
                                    <% }) %>
                                </select>
                            </td>
                            <td>
                                <% if (item.status === 'rented') { %>
                                    <%- helpers.itemStatusBadge('rented') %>
                                <% } else { %>
                                    <form method="POST" action="/admin/items/<%= item._id %>/status">
                                        <input type="hidden" name="back_category" value="<%= category %>">
                                        <select name="status" onchange="this.form.submit()" style="padding: 4px 8px;">
                                            <option value="available" <%= item.status === 'available' ? 'selected' : '' %>>Available</option>
                                            <option value="maintenance" <%= item.status === 'maintenance' ? 'selected' : '' %>>Under Maintenance</option>
                                            <option value="damaged" <%= item.status === 'damaged' ? 'selected' : '' %>>Damaged</option>
                                        </select>
                                    </form>
                                <% } %>
                            </td>
                            <td><%= helpers.formatDate(item.createdAt) %></td>
                            <td>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <button form="edit-<%= item._id %>" type="submit" style="padding: 4px 10px; background: #3B82F6; color: white; border: none; border-radius: 4px; cursor: pointer;">Save</button>
                                    <form method="POST" action="/admin/items/<%= item._id %>/delete" onsubmit="return confirm('Delete this item?')">
                                        <input type="hidden" name="back_category" value="<%= category %>">
                                        <button type="submit" style="background: none; border: none; color: #DC2626; cursor: pointer;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p style="padding: 40px; text-align: center; color: #6B7280;">No items found. Add your first item above.</p>
    <% } %>
</div>

<%- include('../partials/admin-bottom') %>