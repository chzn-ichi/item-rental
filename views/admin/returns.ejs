<%- include('../partials/admin-top', { title: 'Process Returns', activePage: 'returns' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Process returns</h1>
        <p class="page-sub">Check each returned item and record its condition.</p>
    </div>
</div>

<div class="table-container">
    <h3>Waiting for verification <span class="count">(<%= pending.length %>)</span></h3>
    <% if (pending.length > 0) { %>
        <table>
            <thead>
                <tr><th>Student</th><th>Email</th><th>Item code</th><th>Item name</th><th>Category</th><th>Borrow date</th><th>Action</th></tr>
            </thead>
            <tbody>
                <% pending.forEach(r => { %>
                    <tr>
                        <td><strong><%= r.user ? r.user.name : '—' %></strong></td>
                        <td><%= r.user ? r.user.email : '—' %></td>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td>
                            <form method="POST" action="/admin/returns/process" class="inline-form"
                                  data-confirm="The condition and penalty can't be changed after this."
                                  data-confirm-title="Process return" data-confirm-label="Process">
                                <input type="hidden" name="rental_id" value="<%= r._id %>">
                                <select name="condition" required class="select-sm"
                                        onchange="this.form.penalty_amount.disabled = this.value !== 'damaged'">
                                    <option value="">Select condition</option>
                                    <option value="good">Good</option>
                                    <option value="dirty">Dirty</option>
                                    <option value="damaged">Damaged</option>
                                </select>
                                <input type="number" name="penalty_amount" placeholder="Penalty (₱)" step="0.01" min="0" disabled class="select-sm input-money">
                                <button type="submit" class="btn btn-sm btn-primary">Process</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><p>No pending returns. All good!</p></div>
    <% } %>
</div>

<div class="table-container">
    <h3>Recently processed</h3>
    <% if (recent.length > 0) { %>
        <table>
            <thead>
                <tr><th>Student</th><th>Item code</th><th>Item name</th><th>Borrow date</th><th>Return date</th><th>Condition</th><th>Penalty</th></tr>
            </thead>
            <tbody>
                <% recent.forEach(r => { %>
                    <tr>
                        <td><%= r.user ? r.user.name : '—' %></td>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%= helpers.formatDate(r.returnDate) %></td>
                        <td><%= r.returnCondition ? r.returnCondition.charAt(0).toUpperCase() + r.returnCondition.slice(1) : '—' %></td>
                        <td>
                            <% if (r.penalty && r.penalty.amount > 0) { %>
                                <strong><%= helpers.formatMoney(r.penalty.amount) %></strong>
                                <%- helpers.penaltyBadge(r.penalty) %>
                            <% } else { %>
                                <span class="muted">None</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><p>No processed returns yet.</p></div>
    <% } %>
</div>

<div class="note-card">
    <h4>How to process returns</h4>
    <ul>
        <li><strong>Good:</strong> the item is clean and undamaged. It goes back to inventory right away.</li>
        <li><strong>Dirty:</strong> the item needs upkeep. It is set to Under maintenance, and you mark it Available in Manage items when it's ready.</li>
        <li><strong>Damaged:</strong> the item is broken. It is marked Damaged, and you may enter an optional penalty.</li>
    </ul>
    <p>Penalty amounts are set by the dormitory officer based on damage severity.</p>
</div>

<%- include('../partials/admin-bottom') %>