<%- include('../partials/admin-top', { title: 'Admin Dashboard', activePage: 'dashboard' }) %>

<section class="hero">
    <div>
        <h1>Hello, <%= currentUser.name.split(' ')[0] %></h1>
        <p>
            <% if (pendingApprovals + pendingReturns > 0) { %>
                <%= pendingApprovals %> request<%= pendingApprovals === 1 ? '' : 's' %> waiting for approval and <%= pendingReturns %> return<%= pendingReturns === 1 ? '' : 's' %> to verify.
            <% } else { %>
                Nothing is waiting for you right now.
            <% } %>
        </p>
    </div>
    <div class="inline-form">
        <a href="/admin/rentals" class="btn btn-light">Review requests (<%= pendingApprovals %>)</a>
        <a href="/admin/returns" class="btn btn-light">Process returns (<%= pendingReturns %>)</a>
    </div>
</section>

<h2 class="section-label">Inventory</h2>
<div class="stats-grid">
    <div class="stat-card"><div class="stat-label">Total items</div><div class="stat-value"><%= totalItems %></div></div>
    <a href="/admin/items" class="stat-card"><div class="stat-label">Available</div><div class="stat-value"><%= available %></div></a>
    <div class="stat-card"><div class="stat-label">Rented</div><div class="stat-value"><%= rented %></div></div>
    <div class="stat-card"><div class="stat-label">Under maintenance</div><div class="stat-value"><%= maintenance %></div></div>
    <div class="stat-card red"><div class="stat-label">Damaged</div><div class="stat-value"><%= damaged %></div></div>
</div>

<h2 class="section-label">Activity</h2>
<div class="stats-grid">
    <a href="/admin/rentals" class="stat-card"><div class="stat-label">Active rentals</div><div class="stat-value"><%= activeRentals %></div></a>
    <a href="/admin/rentals" class="stat-card red"><div class="stat-label">Overdue rentals</div><div class="stat-value"><%= overdueRentals %></div></a>
    <div class="stat-card"><div class="stat-label">Students</div><div class="stat-value"><%= totalStudents %></div></div>
    <a href="/admin/penalties?status=unpaid" class="stat-card red"><div class="stat-label">Unpaid penalties</div><div class="stat-value"><%= helpers.formatMoney(unpaid.total) %></div></a>
</div>

<div class="table-container">
    <h3>Items by category</h3>
    <div class="chip-row">
        <% categoryCounts.forEach(c => { %>
            <span class="chip"><%= c._id %>: <%= c.count %></span>
        <% }) %>
        <% if (categoryCounts.length === 0) { %><span class="muted">No items yet.</span><% } %>
    </div>
</div>

<div class="table-container">
    <h3>Recent rental activity</h3>
    <% if (recentRentals.length > 0) { %>
        <table>
            <thead>
                <tr><th>Student</th><th>Item code</th><th>Item name</th><th>Category</th><th>Borrow date</th><th>Status</th></tr>
            </thead>
            <tbody>
                <% recentRentals.forEach(r => { %>
                    <tr>
                        <td><%= r.user ? r.user.name : '—' %></td>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%- helpers.rentalStatusBadge(r.status) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><p>No rental activity yet.</p></div>
    <% } %>
</div>

<%- include('../partials/admin-bottom') %>