<%- include('../partials/admin-top', { title: 'Rental History', activePage: 'history' }) %>

<div class="page-head">
    <div>
        <h1 class="page-title">Rental history</h1>
        <p class="page-sub">Every rental request, newest first.</p>
    </div>
</div>

<div class="category-filter">
    <% [['all','All'],['pending','Pending'],['approved','Approved'],['pending_return','Pending return'],['returned','Returned']].forEach(([key, label]) => { %>
        <a href="/admin/history<%= key === 'all' ? '' : '?status=' + key %>"
           class="filter-btn <%= status === key ? 'active' : '' %>"><%= label %></a>
    <% }) %>
</div>

<div class="table-container">
    <h3>All rentals <span class="count">(<%= rentals.length %>)</span></h3>
    <% if (rentals.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Student</th><th>Email</th><th>Item code</th><th>Item name</th><th>Category</th>
                    <th>Borrow date</th><th>Due date</th><th>Return date</th><th>Condition</th><th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% rentals.forEach(r => { %>
                    <tr>
                        <td><%= r.user ? r.user.name : '—' %></td>
                        <td><%= r.user ? r.user.email : '—' %></td>
                        <td><%= r.itemCode %></td>
                        <td><%= r.itemName %></td>
                        <td><%- helpers.categoryBadge(r.category) %></td>
                        <td><%= helpers.formatDate(r.borrowDate) %></td>
                        <td><%= helpers.formatDate(r.dueDate) %></td>
                        <td><%= helpers.formatDate(r.returnDate) %></td>
                        <td><%= r.returnCondition ? r.returnCondition.charAt(0).toUpperCase() + r.returnCondition.slice(1) : '—' %></td>
                        <td><%- helpers.rentalStatusBadge(r.status) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <div class="empty-state"><p>No rentals found.</p></div>
    <% } %>
</div>

<%- include('../partials/admin-bottom') %>